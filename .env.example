# 꽃 우체국(방명록)이 쓰는 구글 앱스 스크립트 웹앱 주소입니다.
# gas/꽃우체국_code.gs 를 배포하면 나오는 /exec 주소를 넣으세요.
#
# 비워 두면 「데모 모드」로 돌아갑니다.
#   - 예시 명단 6명이 보이고
#   - 놓은 꽃은 서버를 다시 켜면 사라집니다
#   - 화면과 흐름을 확인하는 용도로만 쓰세요
#
# Vercel에 올릴 때는 Settings → Environment Variables 에 같은 이름으로 넣습니다.
GUESTBOOK_GAS_URL=

# 커스텀 도메인을 붙였다면 그 주소를 넣습니다(OG·검색용).
NEXT_PUBLIC_SITE_URL=
